#include <iostream>
#include <vector>
#include <algorithm>
 
using namespace std;
 
int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
 
    int n, m, k;
    if (!(cin >> n >> m >> k)) return 0;
 
    vector<int> min_viability(m + 1, 1e9);
 
    for (int i = 0; i < n; ++i) {
        int r, c;
        cin >> r >> c;
        if (c < min_viability[r]) {
            min_viability[r] = c;
        }
    }
 
    long long total_capacity = 0;
    for (int i = 1; i <= m; ++i) {
        total_capacity += min_viability[i];
    }
 
    long long ans = min((long long)k, total_capacity);
    cout << ans << "
";
 
    return 0;
}